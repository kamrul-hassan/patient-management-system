{
  "name": "careflow-web",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=24 <25", "npm": ">=11 <12" },
  "scripts": {
    "dev": "next dev --hostname localhost",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src next.config.ts",
    "format:check": "prettier --check src next.config.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
